{
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    // File Layout
    // rootDir "./" eksplisit — mencegah warning migrasi TS 6.0
    // (jangan "./src": TS6059 muncul saat tests/ berisi file, karena
    //  include memuat tests/**/* — keputusan terverifikasi di repo OOP)
    "rootDir": "./",
    "outDir": "dist/",
    // Environment Settings
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "target": "esnext",
    "types": [
      "jest"
    ],
    // More Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    // noUncheckedIndexedAccess DIMATIKAN sengaja (keputusan 2026-08-26,
    // mengikuti repo dasar): arr[i] jadi "T | undefined" — mengganggu
    // latihan sebelum materi null-handling. strict: true tetap NYALA.
    // "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes DIMATIKAN sengaja (keputusan 2026-08-27,
    // sesi 19 repo dasar): menolak `prop: undefined` eksplisit pada
    // property optional (TS2375) — padahal itu pola standar TS.
    // "exactOptionalPropertyTypes": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  }
}
